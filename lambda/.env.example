# ── ECS Cluster & Task ───────────────────────────────────────────────────────
ECS_CLUSTER=lensart-cluster
ECS_TASK_DEFINITION=lensart-converter        # family name (latest revision used automatically)
ECS_CONTAINER_NAME=lensart-converter         # must match the container name in the task def
ECS_LAUNCH_TYPE=FARGATE

# Networking — comma-separated, no spaces
ECS_SUBNET_IDS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUP_IDS=sg-xxxxxxxx

# Whether to assign a public IP so the container can reach S3 (set to ENABLED
# if subnets are public; use a NAT gateway for private subnets)
ECS_ASSIGN_PUBLIC_IP=ENABLED

# S3 ─────────────────────────────────────────────────────────────────────────
S3_BUCKET=lensart-files
OUTPUT_PREFIX=converted

# Webhook ────────────────────────────────────────────────────────────────────
WEBHOOK_URL=https://your-api.example.com/scans/conversion-complete
WEBHOOK_SECRET=changeme

# AWS region the Lambda runs in
AWS_REGION=us-east-1
