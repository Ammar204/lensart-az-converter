# Copy to .env.local and fill in. Loaded by `npm run dev:local`.

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=lensart-files-prod
S3_KEY=models/scan_00000000-0000-0000-0000-000000000000.usdz
OUTPUT_PREFIX=converted

# Local backend (start it with `npm run start:dev` in lensart-az-backend)
WEBHOOK_URL=http://localhost:4500/webhook/scan-uploaded
WEBHOOK_SECRET=dev-secret
