# ── ECS Fargate task (AWS) ───────────────────────────────────────────────────
# Credentials: none here in production. The Fargate task role supplies them.
# For a local run, set the two key variables below.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 settings
S3_BUCKET=lensart-files-prod
S3_KEY=models/scan_<uuid>.usdz          # injected per-task by the Lambda override
OUTPUT_PREFIX=converted                 # GLB lands at converted/scan_<uuid>.glb

# Webhook — the FULL endpoint URL, used verbatim. Nothing is appended to it.
WEBHOOK_URL=https://api.lensart.app/webhook/scan-uploaded

# Shared secret used to HMAC-sign the webhook body. Must match WEBHOOK_SECRET
# on the backend, which verifies the X-LensArt-Signature header.
WEBHOOK_SECRET=changeme
