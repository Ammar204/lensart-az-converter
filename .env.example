# ── Cloud Run Job (GCP) ──────────────────────────────────────────────────────
# Credentials: none here. On Cloud Run the attached service account is used via
# Application Default Credentials. For a local run, point
# GOOGLE_APPLICATION_CREDENTIALS at a service-account key file instead.
GOOGLE_CLOUD_PROJECT=lensart-project

# Cloud Storage settings
GCS_BUCKET=lensart-files-prod
GCS_KEY=models/scan_<uuid>.usdz        # injected per-execution by the Workflow
OUTPUT_PREFIX=converted                # GLB lands at converted/scan_<uuid>.glb

# Webhook — the FULL endpoint URL, used verbatim. Nothing is appended to it.
WEBHOOK_URL=https://your-api.example.com/webhook/scan-uploaded

# Shared secret used to HMAC-sign the webhook body. Must match WEBHOOK_SECRET
# on the backend, which verifies the X-LensArt-Signature header.
WEBHOOK_SECRET=changeme
