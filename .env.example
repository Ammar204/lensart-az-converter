# ── ECR App ──────────────────────────────────────────────
# AWS credentials (use IAM Task Role in production — leave blank)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 settings
S3_BUCKET=lensart-files
S3_KEY=models/scan_<uuid>.usdz         # injected by Lambda as ECS env override
OUTPUT_PREFIX=converted                # GLB files land at converted/scan_<uuid>.glb

# Webhook — base URL of the NestJS backend's scans resource.
# At runtime the converter appends "/<scanId>/conversion-complete" (scanId is parsed from S3_KEY).
WEBHOOK_URL=https://your-api.example.com/scans

# Shared secret used to HMAC-sign the webhook body. Must match WEBHOOK_SECRET on the backend.
WEBHOOK_SECRET=changeme
